
# CLI tool, only in development environment.
# https://goframe.org/docs/cli
gfcli:
  gen:
    dao:
      - link:           "mysql:root:root@tcp(127.0.0.1:3306)/hinay_admin?charset=utf8mb4&parseTime=true&loc=Local"
        descriptionTag: true
        removePrefix:   ""
        jsonCase:       "CamelLower"

  docker:
    build: "-a amd64 -s linux -p temp -ew"
    tagPrefixes:
      - my.image.pub/my-app
