# Docker Compose 环境变量模板, 复制为 .env 并替换为真实值
# 生成 JWT 密钥: openssl rand -hex 32

# ---------- 部署模式 ----------
# 默认 (留空): 使用外部 MySQL/Redis, 仅启动 server + web
# 内置模式: 取消下一行注释, 由 compose 额外启动 MariaDB + Redis 容器
# COMPOSE_PROFILES=bundled

# ---------- 必填 ----------
# 数据库密码: 内置模式=MariaDB root 密码; 外部模式=MYSQL_USER 账号的密码
MYSQL_ROOT_PASSWORD=change-me-strong-db-password
# JWT 密钥, 必填
JWT_SECRET=change-me-openssl-rand-hex-32-result

# ---------- 数据库连接 (外部模式按实际填写; 内置模式保持默认) ----------
MYSQL_DATABASE=hinay_admin
# MYSQL_HOST=host.docker.internal   # 宿主机上的 MySQL (server 容器已配 host-gateway 映射); 远程库填实际地址
# MYSQL_PORT=3306
# MYSQL_USER=root

# ---------- Redis 连接 ----------
# REDIS_HOST=host.docker.internal
# REDIS_PORT=6379

# ---------- 外部 MySQL/Redis 以容器方式运行时 ----------
# 已发布端口到宿主机 (-p 3306:3306): 直接 host.docker.internal + 端口, 无需额外配置
# 未发布端口: 容器名 DNS 只在同一 Docker 网络内生效, 需接入共享网络 (详见 docker-compose.external-net.yml):
# EXTERNAL_NETWORK=shared-db
# COMPOSE_FILE=docker-compose.yml:docker-compose.external-net.yml
# 接入后 MYSQL_HOST/REDIS_HOST 直接填外部容器名/网络别名

# 外部模式的数据库需先执行基线初始化 (建表+种子):
#   cd server && make initdb DB_HOST=<库地址> DB_USER=<账号> DB_PASS=<密码> DB_NAME=hinay_admin

# 演示模式: true 时全局禁止修改/重置密码 (公开演示部署时开启)
DEMO_MODE=false
